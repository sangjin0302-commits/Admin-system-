generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma-client-next"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

model PortalClient {
  id              String    @id @default(cuid())
  email           String    @unique
  hashedPassword  String
  name            String
  phone           String?
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  linkedInquiryIds String   @default("[]")
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  uploadedFiles   PortalUploadedFile[]

  @@index([email])
  @@index([resetTokenHash])
}

model PortalUploadedFile {
  id          String   @id @default(cuid())
  clientId    String
  client      PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inquiryId   String?
  caseId      String?
  fileName    String
  storedPath  String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime @default(now())

  @@index([clientId])
  @@index([inquiryId])
  @@index([caseId])
}

model Credential {
  id          String   @id @default(cuid())
  type        String   @default("CAREER") // CAREER | LICENSE | EDUCATION | AWARD | ACTIVITY
  year        String   // "2020", "2020.03", "2020~현재"
  title       String
  detail      String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model FeeItem {
  id          String   @id @default(cuid())
  category    String   // VISA_STAY | ADMIN_APPEAL | CONTRACT_INVESTIGATION | LICENSE_PERMIT | ETC
  service     String
  amount      String   // 자유 형식: "33만원", "사안별 협의", "착수 50만 + 성공보수"
  note        String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}

model Testimonial {
  id          String   @id @default(cuid())
  category    String   // VISA_STAY | ADMIN_APPEAL | CONTRACT_INVESTIGATION | LICENSE_PERMIT
  quote       String
  author      String
  context     String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model CaseStudy {
  id          String   @id @default(cuid())
  category    String   // VISA_STAY | ADMIN_APPEAL | CONTRACT_INVESTIGATION | LICENSE_PERMIT
  title       String
  summary     String
  outcome     String
  duration    String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model SiteSetting {
  key       String   @id            // e.g. "home.heroTitle", "naver.blogId"
  value     String                  // 텍스트 / JSON 문자열
  updatedAt DateTime @updatedAt
  updatedBy String?                 // 수정한 관리자 식별자 (선택)
}

model PortalNotification {
  id          String   @id @default(cuid())
  clientId    String
  caseId      String?
  inquiryId   String?
  event       String   // case_status_changed, document_requested, case_closed, message, etc.
  title       String
  body        String
  link        String?  // e.g., /portal/cases/abc123
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([clientId, readAt])
  @@index([caseId])
  @@index([inquiryId])
}

enum InquiryType {
  FOREIGNER_VISA
  IMMIGRATION_STAY
  APOSTILLE_CONSULAR
  TRANSLATION_NOTARY
  GENERAL_ADMIN_CIVIL
  CORPORATE_REQUEST
  UNKNOWN
}

enum InquiryStatus {
  NEW
  PRE_DIAGNOSED
  CONSULTATION_REQUIRED
  QUOTE_DRAFTED
  QUOTE_PENDING
  ON_HOLD
  IN_REVIEW
  WAITING_CONSULTATION
  QUOTE_SENT
  WON
  CLOSED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LanguageCode {
  KO
  EN
  AR
}

enum PricingOptionType {
  FLAT
  PERCENT
}

enum PricingRuleType {
  URGENCY
  CONSULT
  PAYMENT
  POLICY
}

enum QuoteStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteLineKind {
  SERVICE
  URGENCY
  MANUAL
}

enum PaymentStageKind {
  RETAINER
  MIDTERM
  SUCCESS
}

enum ContractDraftStatus {
  DRAFT
  FINALIZED
  VOID
}

enum AccountingFeeStatus {
  UNSET
  ESTIMATED
  CONFIRMED
  WAIVED
}

enum AccountingPaymentStatus {
  UNSET
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum CaseStage {
  CONTRACT_PREPARATION
  ACTIVE
  ON_HOLD
  CLOSED
}

enum CaseMatterCategory {
  VISA_STAY        // 비자/외국인 체류
  ADMIN_APPEAL     // 행정심판
  CONTRACT_INVESTIGATION // 계약서/사실조사
  LICENSE_PERMIT   // 인허가
  OTHER
}

enum BridgeWorkflowStatus {
  NEW_INQUIRY
  TRIAGE_REVIEW
  AWAITING_MORE_FACTS
  PROFILED
  PROFILE_REVIEW_REQUIRED
  CASE_CARD_CREATED
  AWAITING_SOURCE_VERIFICATION
  DRAFT_CREATED
  MESSAGE_DRAFT_CREATED
  APPROVAL_PENDING
  APPROVED
  REVISION_REQUESTED
  BLOCKED
  CLOSED
}

enum WorkflowTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELED
}

enum WorkflowDraftStatus {
  DRAFT_CREATED
  APPROVAL_PENDING
  APPROVED
  REVISION_REQUESTED
  BLOCKED
  ARCHIVED
}

enum CaseMatterStatus {
  INTAKE_REVIEW
  CONSULTING
  QUOTED
  CONTRACT_PENDING
  OPEN
  DOCUMENT_COLLECTING
  DOCUMENT_REVIEWING
  READY_TO_SUBMIT
  SUBMITTED
  SUPPLEMENT_REQUESTED
  WAITING_AGENCY
  RESULT_RECEIVED
  CLOSING
  CLOSED
  CANCELLED
  ON_HOLD
}

enum RiskLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CasePartyRole {
  CLIENT
  APPLICANT
  GUARDIAN
  EMPLOYER
  AGENT
  OTHER
}

enum RequiredDocumentStatus {
  NEEDED
  REQUESTED
  RECEIVED
  IN_REVIEW
  NEEDS_FIX
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

enum CaseDocumentStatus {
  RECEIVED
  IN_REVIEW
  NEEDS_FIX
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocumentVersionStatus {
  DRAFT
  CLIENT_PROVIDED
  INTERNAL_EDIT
  REVIEWED
  APPROVED_FOR_SUBMISSION
  SUPERSEDED
  VOID
}

enum SubmissionPackageStatus {
  DRAFT
  READY
  SUBMITTED
  CANCELLED
  ARCHIVED
}

enum SubmissionMethod {
  ONLINE
  VISIT
  POSTAL
  EMAIL
  OTHER
}

enum AgencySubmissionStatus {
  READY
  SUBMITTED
  RECEIPTED
  UNDER_REVIEW
  SUPPLEMENT_REQUESTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum SupplementStatus {
  RECEIVED
  ANALYZING
  DOCS_REQUESTED
  CLIENT_WAITING
  RESPONSE_DRAFTING
  READY_TO_RESPOND
  RESPONDED
  CLOSED
  OVERDUE
  CANCELLED
}

enum CaseTaskStatus {
  OPEN
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum CaseTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Inquiry {
  id                       String        @id @default(cuid())
  orgId                    String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  status                   InquiryStatus @default(NEW)
  inquiryType              InquiryType   @default(UNKNOWN)
  urgencyLevel             UrgencyLevel  @default(MEDIUM)
  classificationConfidence Float         @default(0)
  qualificationScore       Int           @default(0)
  preferredLanguage        LanguageCode  @default(KO)
  clientType               ClientType    @default(INDIVIDUAL)
  contactName              String
  organizationName         String?
  email                    String
  phone                    String?
  title                    String
  description              String
  nationality              String?
  currentStatus            String?
  requestedOutcome         String?
  requestedInquiryType     InquiryType?
  declaredUrgency          UrgencyLevel?
  documentCountry          String?
  targetAgency             String?
  hasPreparedDocuments     Boolean       @default(false)
  needsTranslation         Boolean       @default(false)
  isCorporateRequest       Boolean       @default(false)
  dueDate                  DateTime?
  assignee                 String?
  internalMemo             String?
  communicationLogs        String        @default("[]")
  latestContactAt          DateTime?
  latestContactChannel     String?
  latestContactSummary     String?
  nextContactAt            DateTime?
  responsePending          Boolean       @default(false)
  consultationRequired     Boolean       @default(false)
  riskComplexityHint       String?
  precheckRecommendedDocs  String        @default("[]")
  wantsCallback            Boolean       @default(false)
  consentToPrivacy         Boolean       @default(false)
  intakeSource             String        @default("website")
  intakeChannel            String?
  intakePracticeArea       String?
  intakeContentId          String?
  intakePackageId          String?
  intakeCampaignId         String?
  intakeUtmSource          String?
  intakeUtmMedium          String?
  intakeUtmCampaign        String?
  intakeUtmContent         String?
  intakeRef                String?
  intakeLandingUrl         String?
  intakeTrackingCapturedAt DateTime?
  publicTrackingCode       String?       @unique
  publicTrackingPhoneLast4 String?
  publicTrackingIssuedAt   DateTime?
  generatedSummary         String
  generatedGuidance        String
  generatedReceiptMessage  String
  classificationReason     String
  recommendedNextStep      String
  serviceTags              String        @default("[]")
  lawbotLastAnalyzedAt     DateTime?
  lawbotSnapshotVersion    Int           @default(1)
  lawbotSnapshotStatus     String?
  lawbotSnapshotSummary    String?
  lawbotSnapshotPayload    String?
  bridgeWorkflowStatus     BridgeWorkflowStatus @default(NEW_INQUIRY)
  bridgeReviewRequired     Boolean       @default(false)
  bridgeMustVerify         String        @default("[]")
  bridgeMustVerifySources  String        @default("[]")
  bridgeRiskFlags          String        @default("[]")
  bridgePractitionerGuide  String?
  bridgeCaseOutlook        String?
  intakeCategory           String?
  quotes                   Quote[]
  contractDrafts           ContractDraft[]
  cases                    CaseRecord[]
  caseMatters              CaseMatter[]
  caseTasks                CaseTask[]
  sourceVerificationTasks  SourceVerificationTask[]
  documentRequestTasks     DocumentRequestTask[]
  documentDrafts           DocumentDraft[]
  messageDrafts            MessageDraft[]

  @@index([publicTrackingPhoneLast4])
  @@index([publicTrackingIssuedAt])
  @@index([intakeSource])
  @@index([intakeChannel])
  @@index([intakePracticeArea])
  @@index([intakeContentId])
}

model ServiceType {
  id             String          @id @default(cuid())
  legacyId       String          @unique
  name           String
  category       String
  minPrice       Int
  maxPrice       Int
  isAppeal       Boolean         @default(false)
  isActive       Boolean         @default(true)
  source         String          @default("legacy-admin-suite")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quoteLineItems QuoteLineItem[]
}

model PricingOption {
  id               String            @id @default(cuid())
  legacyId         String            @unique
  name             String
  description      String
  optionType       PricingOptionType
  flatAmount       Int?
  percentRate      Int?
  unitLabel        String?
  isVat            Boolean           @default(false)
  isActive         Boolean           @default(true)
  source           String            @default("legacy-admin-suite")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quoteAdjustments QuoteAdjustment[]
}

model PricingRule {
  id           String          @id @default(cuid())
  code         String          @unique
  ruleType     PricingRuleType
  label        String
  description  String?
  numericValue Int?
  percentValue Int?
  jsonValue    String?
  isDefault    Boolean         @default(false)
  isActive     Boolean         @default(true)
  source       String          @default("legacy-admin-suite")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Quote {
  id                    String         @id @default(cuid())
  inquiryId             String
  inquiry               Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseMatterId          String?
  caseMatter            CaseMatter?    @relation("CaseMatterQuotes", fields: [caseMatterId], references: [id], onDelete: SetNull)
  status                QuoteStatus    @default(DRAFT)
  selectedServiceLegacyIds String      @default("[]")
  selectedOptionLegacyIds String       @default("[]")
  urgencyRuleCode       String
  consultRuleCode       String
  paymentRuleCode       String         @default("PAYMENT_STANDARD")
  rangeMode             Boolean        @default(true)
  serviceBaseMin        Int            @default(0)
  serviceBaseMax        Int            @default(0)
  subtotalMin           Int            @default(0)
  subtotalMax           Int            @default(0)
  vatAmountMin          Int            @default(0)
  vatAmountMax          Int            @default(0)
  totalMin              Int            @default(0)
  totalMax              Int            @default(0)
  consultFee            Int            @default(0)
  successFeeRestricted  Boolean        @default(false)
  draftNotes            String?
  calculationSummary    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lineItems             QuoteLineItem[]
  adjustments           QuoteAdjustment[]
  paymentPlans          PaymentPlan[]
  contractDraft         ContractDraft?
  caseRecord            CaseRecord?
}

model QuoteLineItem {
  id            String         @id @default(cuid())
  quoteId       String
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceTypeId String?
  serviceType   ServiceType?   @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  kind          QuoteLineKind
  label         String
  description   String?
  amountMin     Int
  amountMax     Int
  sortOrder     Int            @default(0)
  isManual      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuoteAdjustment {
  id              String            @id @default(cuid())
  quoteId         String
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  pricingOptionId String?
  pricingOption   PricingOption?    @relation(fields: [pricingOptionId], references: [id], onDelete: SetNull)
  label           String
  description     String?
  optionType      PricingOptionType
  flatAmount      Int?
  percentRate     Int?
  computedMin     Int
  computedMax     Int
  isVat           Boolean           @default(false)
  sortOrder       Int               @default(0)
  isManual        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PaymentPlan {
  id         String           @id @default(cuid())
  quoteId    String
  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  stageKind  PaymentStageKind
  percentage Int
  dueText    String
  amountMin  Int
  amountMax  Int
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ContractDraft {
  id                   String              @id @default(cuid())
  inquiryId            String
  inquiry              Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quoteId              String              @unique
  quote                Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  caseMatterId         String?
  caseMatter           CaseMatter?         @relation("CaseMatterContractDrafts", fields: [caseMatterId], references: [id], onDelete: SetNull)
  status               ContractDraftStatus @default(DRAFT)
  title                String
  bodyText             String
  scopeText            String?
  paymentSummary       String?
  successFeeRestricted Boolean             @default(false)
  specialTerms         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  caseRecord           CaseRecord?
}

model CaseRecord {
  id              String    @id @default(cuid())
  caseNumber      String    @unique
  inquiryId       String
  quoteId         String?   @unique
  contractDraftId String?   @unique
  currentStage    CaseStage @default(CONTRACT_PREPARATION)
  bridgeWorkflowStatus    BridgeWorkflowStatus @default(CASE_CARD_CREATED)
  bridgeReviewRequired    Boolean   @default(false)
  bridgeMustVerify        String    @default("[]")
  bridgeMustVerifySources String    @default("[]")
  bridgeRiskFlags         String    @default("[]")
  bridgePractitionerGuide String?
  bridgeCaseOutlook       String?
  dueDate         DateTime?
  internalMemo    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  inquiry         Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quote           Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contractDraft   ContractDraft? @relation(fields: [contractDraftId], references: [id], onDelete: SetNull)
  caseMatter      CaseMatter? @relation("CaseMatterLegacyCaseRecord")
  sourceVerificationTasks SourceVerificationTask[]
  documentRequestTasks    DocumentRequestTask[]
  documentDrafts          DocumentDraft[]
  messageDrafts           MessageDraft[]
}

model CaseMatter {
  id                 String             @id @default(cuid())
  orgId               String?
  caseNo              String?            @unique
  title               String
  matterType          String
  category            CaseMatterCategory @default(OTHER)
  status              CaseMatterStatus   @default(INTAKE_REVIEW)
  riskLevel           RiskLevel          @default(NORMAL)
  priority            CasePriority       @default(NORMAL)
  inquiryId           String?
  inquiry             Inquiry?           @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  legacyCaseRecordId  String?            @unique
  legacyCaseRecord    CaseRecord?        @relation("CaseMatterLegacyCaseRecord", fields: [legacyCaseRecordId], references: [id], onDelete: SetNull)
  openedAt            DateTime?
  closedAt            DateTime?
  dueDate             DateTime?
  nextActionAt        DateTime?
  assignedTo          String?
  summary             String?
  internalMemo        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  parties             CaseParty[]
  requiredDocuments   RequiredDocument[]
  documents           CaseDocument[]
  submissionPackages  SubmissionPackage[]
  submissions         AgencySubmission[]
  supplementRequests  SupplementRequest[]
  tasks               CaseTask[]
  events              CaseEvent[]
  quotes              Quote[]            @relation("CaseMatterQuotes")
  contractDrafts      ContractDraft[]    @relation("CaseMatterContractDrafts")
  accountingMemo      CaseAccountingMemo?
  immigrationDetail   ImmigrationCaseDetail?
  adminAppealDetail   AdminAppealDetail?
  contractDetail      ContractInvestigationDetail?
  licenseDetail       LicensePermitDetail?

  @@index([status])
  @@index([matterType])
  @@index([category])
  @@index([dueDate])
  @@index([nextActionAt])
  @@index([priority])
}

model CaseAccountingMemo {
  id            String                  @id @default(cuid())
  caseId        String                  @unique
  caseMatter    CaseMatter              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  feeAmount     Int?
  feeStatus     AccountingFeeStatus     @default(UNSET)
  paymentStatus AccountingPaymentStatus @default(UNSET)
  paidAmount    Int?
  paidAt        DateTime?
  paymentMemo   String?
  invoiceMemo   String?
  ledgerMemo    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([feeStatus])
  @@index([paymentStatus])
}

model ImmigrationCaseDetail {
  id                         String     @id @default(cuid())
  caseId                     String     @unique
  caseMatter                 CaseMatter @relation(fields: [caseId], references: [id], onDelete: Cascade)
  dispositionType            String?
  dispositionDate            DateTime?
  noticeDate                 DateTime?
  serviceDate                DateTime?
  appealDeadline             DateTime?
  departureDeadline          DateTime?
  detentionStartDate         DateTime?
  stayExpiryDate             DateTime?
  submissionDeadline         DateTime?
  supplementDeadline         DateTime?
  resultExpectedDate         DateTime?
  nationality                String?
  currentStayStatus          String?
  familyInKoreaSummary       String?
  residenceBaseSummary       String?
  employmentOrSchoolSummary  String?
  violationHistorySummary    String?
  scopeReviewRequired        Boolean    @default(true)
  attorneyScopeRisk          Boolean    @default(false)
  officialFormCheckRequired  Boolean    @default(true)
  deadlineVerifiedAt         DateTime?
  verifiedBy                 String?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  @@index([dispositionType])
  @@index([appealDeadline])
  @@index([departureDeadline])
  @@index([stayExpiryDate])
  @@index([deadlineVerifiedAt])
}

enum AdminAppealResult {
  PENDING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  WITHDRAWN
  DISMISSED
}

enum AdminAppealType {
  ADMINISTRATIVE_APPEAL      // 행정심판
  ADMINISTRATIVE_LITIGATION  // 행정소송
  OBJECTION                  // 이의신청
  PETITION                   // 진정
}

model AdminAppealDetail {
  id                    String             @id @default(cuid())
  caseId                String             @unique
  caseMatter            CaseMatter         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appealType            AdminAppealType    @default(ADMINISTRATIVE_APPEAL)
  disposingAgency       String?            // 처분청
  reviewingAgency       String?            // 재결청
  dispositionContent    String?            // 처분 내용
  dispositionDate       DateTime?          // 처분일
  noticeReceivedDate    DateTime?          // 처분 통지 수령일
  filingDeadline        DateTime?          // 청구기한 (처분일로부터 90일)
  filedAt               DateTime?          // 실제 청구일
  hearingDate           DateTime?          // 심리기일
  decisionExpectedDate  DateTime?          // 재결 예정일
  decisionReceivedDate  DateTime?          // 재결서 수령일
  result                AdminAppealResult  @default(PENDING)
  resultSummary         String?            // 재결 요지
  groundsSummary        String?            // 청구 이유 요약
  evidenceSummary       String?            // 주요 증거 요약
  caseNoOfficial        String?            // 공식 사건번호
  deadlineVerifiedAt    DateTime?
  verifiedBy            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([appealType])
  @@index([filingDeadline])
  @@index([result])
  @@index([dispositionDate])
}

enum ContractType {
  SERVICE_CONTRACT       // 용역계약
  LEASE_CONTRACT         // 임대차계약
  EMPLOYMENT_CONTRACT    // 고용계약
  PARTNERSHIP_CONTRACT   // 동업계약
  FACT_INVESTIGATION     // 사실조사
  OTHER
}

enum InvestigationStatus {
  REQUESTED
  IN_PROGRESS
  REPORT_DRAFTED
  REPORT_DELIVERED
  COMPLETED
  CANCELLED
}

enum LicensePermitType {
  BUSINESS_LICENSE       // 사업허가
  CONSTRUCTION_PERMIT    // 건축허가
  FOOD_SERVICE_LICENSE   // 식품영업허가
  MEDICAL_LICENSE        // 의료업허가
  FOREIGNER_EMPLOYMENT   // 외국인 고용허가
  TELECOM_LICENSE        // 통신사업허가
  ENVIRONMENT_PERMIT     // 환경관련 허가
  OTHER
}

enum LicensePermitStage {
  CONSULTATION           // 사전 상담
  DOCUMENT_PREP          // 서류 준비
  APPLICATION_FILED      // 신청 접수
  UNDER_REVIEW           // 심사 중
  SUPPLEMENT_REQUESTED   // 보완 요청
  APPROVED               // 허가
  REJECTED               // 불허
  APPEALING              // 불복 진행 중
  COMPLETED              // 완료
}

model LicensePermitDetail {
  id                    String             @id @default(cuid())
  caseId                String             @unique
  caseMatter            CaseMatter         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  permitType            LicensePermitType  @default(OTHER)
  targetAgency          String?            // 허가 관청
  applicationNo         String?            // 접수번호
  businessName          String?            // 사업체명
  businessAddress       String?            // 사업장 소재지
  applicationDate       DateTime?          // 신청일
  reviewDeadline        DateTime?          // 처리기한
  approvalDate          DateTime?          // 허가일
  expiryDate            DateTime?          // 유효기간 만료일
  stage                 LicensePermitStage @default(CONSULTATION)
  requirementsSummary   String?            // 허가 요건 요약
  missingRequirements   String?            // 미충족 요건
  supplementContent     String?            // 보완 요청 내용
  supplementDueDate     DateTime?          // 보완 기한
  conditionsSummary     String?            // 허가 조건
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([permitType])
  @@index([stage])
  @@index([reviewDeadline])
  @@index([supplementDueDate])
}

model ContractInvestigationDetail {
  id                    String              @id @default(cuid())
  caseId                String              @unique
  caseMatter            CaseMatter          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contractType          ContractType        @default(OTHER)
  counterpartyName      String?             // 상대방
  counterpartyContact   String?
  contractDate          DateTime?           // 계약일
  contractAmount        Int?                // 계약금액 (원)
  contractSummary       String?             // 계약 내용 요약
  disputeContent        String?             // 분쟁 내용
  investigationStatus   InvestigationStatus @default(REQUESTED)
  investigationScope    String?             // 사실조사 범위
  reportDueDate         DateTime?           // 보고서 기한
  reportDeliveredAt     DateTime?           // 보고서 납부일
  keyFindings           String?             // 주요 조사 결과
  legalBasisSummary     String?             // 법적 근거 요약
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([contractType])
  @@index([investigationStatus])
  @@index([reportDueDate])
}

model CaseParty {
  id          String         @id @default(cuid())
  caseId       String
  caseMatter   CaseMatter     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role         CasePartyRole
  name         String
  phone        String?
  email        String?
  organization String?
  nationality  String?
  memo         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([caseId])
  @@index([role])
}

model RequiredDocument {
  id           String                 @id @default(cuid())
  caseId       String
  caseMatter   CaseMatter             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  required     Boolean                @default(true)
  status       RequiredDocumentStatus @default(NEEDED)
  dueDate      DateTime?
  requestedAt  DateTime?
  receivedAt   DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  documents    CaseDocument[]

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
}

model CaseDocument {
  id               String             @id @default(cuid())
  caseId           String
  caseMatter       CaseMatter         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requiredDocId    String?
  requiredDocument RequiredDocument?  @relation(fields: [requiredDocId], references: [id], onDelete: SetNull)
  title            String
  docType          String
  status           CaseDocumentStatus @default(RECEIVED)
  currentVersionId String?
  currentVersion   DocumentVersion?   @relation("CaseDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  storageKey       String?
  originalFileName String?
  mimeType         String?
  checksum         String?
  uploadedBy       String?
  receivedAt       DateTime?
  reviewedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  versions         DocumentVersion[]  @relation("CaseDocumentVersions")
  packageItems     SubmissionPackageItem[]

  @@index([caseId])
  @@index([requiredDocId])
  @@index([status])
}

model DocumentVersion {
  id                  String                @id @default(cuid())
  documentId          String
  document            CaseDocument          @relation("CaseDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNo           Int
  status              DocumentVersionStatus @default(DRAFT)
  storageKey          String?
  fileName            String
  mimeType            String?
  checksum            String?
  changeNote          String?
  createdBy           String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime              @default(now())
  currentForDocuments CaseDocument[]        @relation("CaseDocumentCurrentVersion")
  packageItems        SubmissionPackageItem[]

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@index([status])
}

model SubmissionPackage {
  id              String                  @id @default(cuid())
  caseId          String
  caseMatter      CaseMatter              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title           String
  status          SubmissionPackageStatus @default(DRAFT)
  targetAgency    String?
  targetOffice    String?
  preparedAt      DateTime?
  reviewedAt      DateTime?
  lockedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  items           SubmissionPackageItem[]
  submissions     AgencySubmission[]

  @@index([caseId])
  @@index([status])
}

model SubmissionPackageItem {
  id         String             @id @default(cuid())
  packageId   String
  package     SubmissionPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  documentId  String
  document    CaseDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId   String?
  version     DocumentVersion?   @relation(fields: [versionId], references: [id], onDelete: SetNull)
  orderNo     Int                @default(0)
  note        String?
  createdAt   DateTime           @default(now())

  @@unique([packageId, documentId])
  @@index([packageId])
}

model AgencySubmission {
  id                String               @id @default(cuid())
  caseId            String
  caseMatter        CaseMatter           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  packageId         String?
  package           SubmissionPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  agencyName        String
  officeName        String?
  method            SubmissionMethod
  status            AgencySubmissionStatus @default(READY)
  submittedAt       DateTime?
  receiptNo         String?
  receiptFileKey    String?
  resultStatus      String?
  resultReceivedAt  DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  supplementRequests SupplementRequest[]

  @@index([caseId])
  @@index([status])
  @@index([submittedAt])
}

model SupplementRequest {
  id               String           @id @default(cuid())
  caseId           String
  caseMatter       CaseMatter       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submissionId     String?
  submission       AgencySubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           SupplementStatus @default(RECEIVED)
  receivedAt       DateTime
  dueDate          DateTime?
  respondedAt      DateTime?
  requestedDocsJson String?
  responseNote     String?
  responsePackageId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
}

model CaseTask {
  id          String           @id @default(cuid())
  inquiryId   String?
  inquiry     Inquiry?         @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  caseId      String?
  caseMatter  CaseMatter?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title       String
  details     String?
  taskType    String           @default("GENERAL")
  description String?
  status      CaseTaskStatus    @default(TODO)
  reviewRequired Boolean       @default(false)
  mustVerify  String           @default("[]")
  riskFlags   String           @default("[]")
  source      String           @default("manual")
  priority    CaseTaskPriority  @default(NORMAL)
  dueDate     DateTime?
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([inquiryId, status])
  @@index([caseId])
  @@index([status])
  @@index([dueDate])
}

model SourceVerificationTask {
  id               String             @id @default(cuid())
  inquiryId        String
  caseId           String?
  documentDraftId  String?
  messageDraftId   String?
  title            String
  authorityBucket  String?
  sourceLabel      String
  sourceCitation   String?
  notes            String?
  status           WorkflowTaskStatus @default(OPEN)
  reviewRequired   Boolean            @default(true)
  mustVerify       String             @default("[]")
  riskFlags        String             @default("[]")
  source           String             @default("lawbot_bridge")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resolvedAt       DateTime?
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord       CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  documentDraft    DocumentDraft?     @relation(fields: [documentDraftId], references: [id], onDelete: SetNull)
  messageDraft     MessageDraft?      @relation(fields: [messageDraftId], references: [id], onDelete: SetNull)

  @@index([inquiryId, status])
  @@index([caseId, status])
  @@index([documentDraftId])
  @@index([messageDraftId])
}

model DocumentRequestTask {
  id               String             @id @default(cuid())
  inquiryId        String
  caseId           String?
  title            String
  documentLabel    String
  notes            String?
  status           WorkflowTaskStatus @default(OPEN)
  reviewRequired   Boolean            @default(false)
  mustVerify       String             @default("[]")
  riskFlags        String             @default("[]")
  source           String             @default("lawbot_bridge")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resolvedAt       DateTime?
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord       CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model DocumentDraft {
  id                      String              @id @default(cuid())
  inquiryId               String
  caseId                  String?
  draftType               String
  title                   String?
  bodyJson                String              @default("{}")
  status                  WorkflowDraftStatus @default(DRAFT_CREATED)
  reviewRequired          Boolean             @default(true)
  mustVerify              String              @default("[]")
  mustVerifySources       String              @default("[]")
  riskFlags               String              @default("[]")
  practitionerGuide       String?
  caseOutlook             String?
  source                  String              @default("lawbot_bridge")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  approvedAt              DateTime?
  inquiry                 Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord              CaseRecord?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  sourceVerificationTasks SourceVerificationTask[]

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model MessageDraft {
  id                      String              @id @default(cuid())
  inquiryId               String
  caseId                  String?
  messageKind             String
  subject                 String
  bodyText                String
  status                  WorkflowDraftStatus @default(DRAFT_CREATED)
  reviewRequired          Boolean             @default(true)
  mustVerify              String              @default("[]")
  mustVerifySources       String              @default("[]")
  riskFlags               String              @default("[]")
  practitionerGuide       String?
  caseOutlook             String?
  source                  String              @default("lawbot_bridge")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  approvedAt              DateTime?
  inquiry                 Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord              CaseRecord?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  sourceVerificationTasks SourceVerificationTask[]

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model CaseEvent {
  id          String      @id @default(cuid())
  caseId       String
  caseMatter   CaseMatter  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType    String
  actorId      String?
  actorName    String?
  message      String
  payloadJson  String?
  createdAt    DateTime    @default(now())

  @@index([caseId])
  @@index([eventType])
  @@index([createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  body        String
  category    String   @default("general")
  tags        String   @default("[]")
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorName  String   @default("ETHOS 행정사사무소")
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  titleEn      String?
  bodyEn       String?
  excerptEn    String?
  source       String   @default("manual")
  originalUrl  String?
  importedAt   DateTime?

  @@index([published, publishedAt])
  @@index([slug])
  @@index([category])
  @@index([source, importedAt])
}

model LegacyImportLog {
  id            String   @id @default(cuid())
  source        String
  version       String
  payloadJson   String?
  importedAt    DateTime @default(now())
  createdCount  Int      @default(0)
}

// ---------------------------------------------------------------------------
// Round X — 멀티사무소 (Organization) 기반
// ---------------------------------------------------------------------------

enum OrganizationPlan {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  subdomain   String           @unique
  ownerEmail  String
  plan        OrganizationPlan @default(PRO)
  active      Boolean          @default(true)
  brandColor  String?
  logoUrl     String?
  contactPhone String?
  addressLine String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([subdomain])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Round W — 결제/전자서명/알림 audit trail
// ---------------------------------------------------------------------------

enum PaymentStatus {
  REQUESTED      // 결제 세션 생성됨
  CONFIRMED      // Toss 승인 완료
  CANCELED       // 전체 취소
  PARTIAL_CANCELED
  FAILED
  EXPIRED
}

model Payment {
  id              String        @id @default(cuid())
  orgId           String?
  orderId         String        @unique             // CASE-<caseId>-<suffix>
  paymentKey      String?       @unique             // Toss paymentKey
  caseId          String?
  amount          Int
  currency        String        @default("KRW")
  orderName       String
  customerName    String?
  customerEmail   String?
  status          PaymentStatus @default(REQUESTED)
  method          String?                           // 카드, 가상계좌, 등
  receiptUrl      String?
  rawProviderJson String?                           // 마지막 응답 원본
  approvedAt      DateTime?
  canceledAt      DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([createdAt])
}

enum ESignStatus {
  PENDING
  SIGNED
  REJECTED
  EXPIRED
}

enum ESignProvider {
  IN_MEMORY
  MODUSIGN
}

model ESignRequest {
  id              String         @id @default(cuid())
  orgId           String?
  externalId      String?        @unique           // Modusign document id
  caseId          String?
  documentTitle   String
  signerName      String
  signerEmail     String
  signerPhone     String?
  documentUrl     String?
  templateId      String?
  provider        ESignProvider  @default(IN_MEMORY)
  status          ESignStatus    @default(PENDING)
  signUrl         String?
  internalToken   String                            // in-memory MVP 클릭검증용
  createdAt       DateTime       @default(now())
  signedAt        DateTime?
  expiresAt       DateTime?
  rawProviderJson String?

  @@index([caseId])
  @@index([status])
  @@index([createdAt])
}

enum NotificationChannel {
  ALIMTALK
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED          // 환경변수 미설정 등으로 건너뜀
}

model NotificationLog {
  id           String              @id @default(cuid())
  orgId        String?
  channel      NotificationChannel
  templateId   String?
  recipient    String                                // 전화번호/이메일/디바이스토큰
  caseId       String?
  subject      String?
  body         String?
  variables    String?                               // JSON.stringify
  status       NotificationStatus  @default(QUEUED)
  errorMessage String?
  providerId   String?                               // Solapi messageId 등
  createdAt    DateTime            @default(now())
  sentAt       DateTime?

  @@index([caseId])
  @@index([status, createdAt])
  @@index([channel, status])
}
