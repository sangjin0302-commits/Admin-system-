generator client {
  provider   = "prisma-client"
  output     = "../../admin-office-mvp-generated/prisma-client"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  STAFF
}

enum AuditEntityType {
  AUTH
  INQUIRY
  QUOTE
  CASE
  SUBMISSION
  SUPPLEMENT
  FOLLOW_UP
}

enum AuditActionType {
  LOGIN
  LOGOUT
  INQUIRY_STATUS_UPDATED
  QUOTE_STATUS_UPDATED
  CASE_STAGE_UPDATED
  SUBMISSION_STATUS_UPDATED
  SUPPLEMENT_STATUS_UPDATED
  FOLLOW_UP_CREATED
  FOLLOW_UP_UPDATED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum InquiryType {
  FOREIGNER_VISA
  IMMIGRATION_STAY
  APOSTILLE_CONSULAR
  TRANSLATION_NOTARY
  GENERAL_ADMIN_CIVIL
  CORPORATE_REQUEST
  UNKNOWN
}

enum InquiryStatus {
  NEW
  PRE_DIAGNOSED
  CONSULTATION_REQUIRED
  QUOTE_DRAFTED
  QUOTE_PENDING
  ON_HOLD
  IN_REVIEW
  WAITING_CONSULTATION
  QUOTE_SENT
  WON
  CLOSED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LanguageCode {
  KO
  EN
  AR
}

enum PricingOptionType {
  FLAT
  PERCENT
}

enum PricingRuleType {
  URGENCY
  CONSULT
  PAYMENT
  POLICY
}

enum QuoteStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteLineKind {
  SERVICE
  URGENCY
  MANUAL
}

enum PaymentStageKind {
  RETAINER
  MIDTERM
  SUCCESS
}

enum ContractDraftStatus {
  DRAFT
  FINALIZED
  VOID
}

enum CaseStage {
  CONTRACT_PREPARATION
  DOCUMENT_COLLECTION
  UNDER_REVIEW
  SUBMITTED
  SUPPLEMENT_REQUESTED
  COMPLETED
  ON_HOLD
  CLOSED
}

enum ClientRelationshipStatus {
  NEUTRAL
  FOLLOW_UP_NEEDED
  REVIEW_REQUESTED
  REFERRAL_POTENTIAL
  RETURNING_CLIENT
}

enum FollowUpActionType {
  REVIEW_REQUEST
  REFERRAL_CHECK
  REENGAGEMENT
}

enum FollowUpActionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SubmissionPackageStatus {
  DRAFT
  SUBMITTED
  SUPPLEMENT_REQUESTED
  RESUBMITTED
  CLOSED
}

enum SupplementRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ForecastMetric {
  INQUIRY_COUNT
  CONTRACT_COUNT
  REVISION_REQUEST_COUNT
}

enum ForecastRunStatus {
  PENDING
  COMPLETED
  FAILED
}

model Inquiry {
  id                       String        @id @default(cuid())
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  status                   InquiryStatus @default(NEW)
  inquiryType              InquiryType   @default(UNKNOWN)
  urgencyLevel             UrgencyLevel  @default(MEDIUM)
  classificationConfidence Float         @default(0)
  qualificationScore       Int           @default(0)
  preferredLanguage        LanguageCode  @default(KO)
  clientType               ClientType    @default(INDIVIDUAL)
  contactName              String
  organizationName         String?
  email                    String
  phone                    String?
  title                    String
  description              String
  nationality              String?
  currentStatus            String?
  requestedOutcome         String?
  requestedInquiryType     InquiryType?
  declaredUrgency          UrgencyLevel?
  documentCountry          String?
  targetAgency             String?
  hasPreparedDocuments     Boolean       @default(false)
  needsTranslation         Boolean       @default(false)
  isCorporateRequest       Boolean       @default(false)
  dueDate                  DateTime?
  assignee                 String?
  internalMemo             String?
  consultationRequired     Boolean       @default(false)
  riskComplexityHint       String?
  precheckRecommendedDocs  String        @default("[]")
  wantsCallback            Boolean       @default(false)
  consentToPrivacy         Boolean       @default(false)
  intakeSource             String        @default("website")
  generatedSummary         String
  generatedGuidance        String
  generatedReceiptMessage  String
  classificationReason     String
  recommendedNextStep      String
  serviceTags              String        @default("[]")
  quotes                   Quote[]
  contractDrafts           ContractDraft[]
  cases                    CaseRecord[]
}

model ServiceType {
  id             String          @id @default(cuid())
  legacyId       String          @unique
  name           String
  category       String
  minPrice       Int
  maxPrice       Int
  isAppeal       Boolean         @default(false)
  isActive       Boolean         @default(true)
  source         String          @default("legacy-admin-suite")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quoteLineItems QuoteLineItem[]
}

model PricingOption {
  id               String            @id @default(cuid())
  legacyId         String            @unique
  name             String
  description      String
  optionType       PricingOptionType
  flatAmount       Int?
  percentRate      Int?
  unitLabel        String?
  isVat            Boolean           @default(false)
  isActive         Boolean           @default(true)
  source           String            @default("legacy-admin-suite")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quoteAdjustments QuoteAdjustment[]
}

model PricingRule {
  id           String          @id @default(cuid())
  code         String          @unique
  ruleType     PricingRuleType
  label        String
  description  String?
  numericValue Int?
  percentValue Int?
  jsonValue    String?
  isDefault    Boolean         @default(false)
  isActive     Boolean         @default(true)
  source       String          @default("legacy-admin-suite")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Quote {
  id                    String         @id @default(cuid())
  inquiryId             String
  inquiry               Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status                QuoteStatus    @default(DRAFT)
  selectedServiceLegacyIds String      @default("[]")
  selectedOptionLegacyIds String       @default("[]")
  urgencyRuleCode       String
  consultRuleCode       String
  paymentRuleCode       String         @default("PAYMENT_STANDARD")
  rangeMode             Boolean        @default(true)
  serviceBaseMin        Int            @default(0)
  serviceBaseMax        Int            @default(0)
  subtotalMin           Int            @default(0)
  subtotalMax           Int            @default(0)
  vatAmountMin          Int            @default(0)
  vatAmountMax          Int            @default(0)
  totalMin              Int            @default(0)
  totalMax              Int            @default(0)
  consultFee            Int            @default(0)
  successFeeRestricted  Boolean        @default(false)
  draftNotes            String?
  calculationSummary    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lineItems             QuoteLineItem[]
  adjustments           QuoteAdjustment[]
  paymentPlans          PaymentPlan[]
  contractDraft         ContractDraft?
  caseRecord            CaseRecord?
}

model QuoteLineItem {
  id            String         @id @default(cuid())
  quoteId       String
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceTypeId String?
  serviceType   ServiceType?   @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  kind          QuoteLineKind
  label         String
  description   String?
  amountMin     Int
  amountMax     Int
  sortOrder     Int            @default(0)
  isManual      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuoteAdjustment {
  id              String            @id @default(cuid())
  quoteId         String
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  pricingOptionId String?
  pricingOption   PricingOption?    @relation(fields: [pricingOptionId], references: [id], onDelete: SetNull)
  label           String
  description     String?
  optionType      PricingOptionType
  flatAmount      Int?
  percentRate     Int?
  computedMin     Int
  computedMax     Int
  isVat           Boolean           @default(false)
  sortOrder       Int               @default(0)
  isManual        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PaymentPlan {
  id         String           @id @default(cuid())
  quoteId    String
  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  stageKind  PaymentStageKind
  percentage Int
  dueText    String
  amountMin  Int
  amountMax  Int
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ContractDraft {
  id                   String              @id @default(cuid())
  inquiryId            String
  inquiry              Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quoteId              String              @unique
  quote                Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status               ContractDraftStatus @default(DRAFT)
  title                String
  bodyText             String
  scopeText            String?
  paymentSummary       String?
  successFeeRestricted Boolean             @default(false)
  specialTerms         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  caseRecord           CaseRecord?
}

model CaseRecord {
  id              String    @id @default(cuid())
  caseNumber      String    @unique
  inquiryId       String
  quoteId         String    @unique
  contractDraftId String?   @unique
  currentStage    CaseStage @default(CONTRACT_PREPARATION)
  dueDate         DateTime?
  filingDeadline  DateTime?
  supplementDeadline DateTime?
  stayExpirationDate DateTime?
  internalDeadline DateTime?
  internalMemo    String?
  closedAt        DateTime?
  closeReason     String?
  outcomeSummary  String?
  nextFollowUpDate DateTime?
  clientRelationshipStatus ClientRelationshipStatus @default(NEUTRAL)
  reviewRequestedAt DateTime?
  reviewCompletedAt DateTime?
  referralEligible Boolean @default(false)
  reengagementEligible Boolean @default(false)
  lastFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  inquiry         Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  contractDraft   ContractDraft? @relation(fields: [contractDraftId], references: [id], onDelete: SetNull)
  documents       CaseDocumentItem[]
  documentFiles   CaseDocumentFile[]
  submissionPackages SubmissionPackage[]
  supplementRequests SupplementRequest[]
  stageLogs       CaseStageLog[]
  followUpActions FollowUpAction[]
}

model FollowUpAction {
  id          String             @id @default(cuid())
  caseId       String
  case         CaseRecord         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type         FollowUpActionType
  status       FollowUpActionStatus @default(PENDING)
  title        String
  note         String?
  dueDate      DateTime?
  messageDraft String
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([caseId, status, dueDate])
}

model CaseDocumentItem {
  id           String   @id @default(cuid())
  caseId        String
  case          CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentType  String
  label         String
  isRequired    Boolean  @default(true)
  isReceived    Boolean  @default(false)
  receivedAt    DateTime?
  note          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  files         CaseDocumentFile[]
  submissionItems SubmissionPackageItem[]
  supplementItems SupplementRequestItem[]

  @@unique([caseId, documentType])
}

model CaseStageLog {
  id         String    @id @default(cuid())
  caseId     String
  case       CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage  CaseStage?
  toStage    CaseStage
  note       String?
  createdAt  DateTime @default(now())
}

model CaseDocumentFile {
  id                 String            @id @default(cuid())
  caseId             String
  case               CaseRecord        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseDocumentItemId String?
  caseDocumentItem   CaseDocumentItem? @relation(fields: [caseDocumentItemId], references: [id], onDelete: SetNull)
  originalFilename   String
  storedFilename     String
  storagePath        String
  mimeType           String
  size               Int
  uploadedAt         DateTime          @default(now())
  note               String?
  isCurrentVersion   Boolean           @default(true)
  versionNumber      Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  submissionItems    SubmissionPackageItem[]

  @@index([caseId, uploadedAt])
  @@index([caseDocumentItemId, versionNumber])
}

model SubmissionPackage {
  id            String                  @id @default(cuid())
  caseId         String
  case           CaseRecord             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  packageNumber  String
  packageLabel   String?
  submittedTo    String?
  submittedAt    DateTime?
  status         SubmissionPackageStatus @default(DRAFT)
  note           String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  items          SubmissionPackageItem[]
  supplementRequests SupplementRequest[]

  @@index([caseId, createdAt])
  @@unique([caseId, packageNumber])
}

model SubmissionPackageItem {
  id                  String            @id @default(cuid())
  submissionPackageId String
  submissionPackage   SubmissionPackage @relation(fields: [submissionPackageId], references: [id], onDelete: Cascade)
  caseDocumentItemId  String
  caseDocumentItem    CaseDocumentItem  @relation(fields: [caseDocumentItemId], references: [id])
  caseDocumentFileId  String
  caseDocumentFile    CaseDocumentFile  @relation(fields: [caseDocumentFileId], references: [id])
  labelSnapshot       String
  versionNumberSnapshot Int
  documentTypeSnapshot String
  filenameSnapshot    String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([submissionPackageId, caseDocumentItemId])
}

model SupplementRequest {
  id                 String                 @id @default(cuid())
  caseId              String
  case                CaseRecord            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submissionPackageId String?
  submissionPackage   SubmissionPackage?    @relation(fields: [submissionPackageId], references: [id], onDelete: SetNull)
  requestedAt         DateTime              @default(now())
  dueDate             DateTime?
  requestedBy         String?
  summary             String
  status              SupplementRequestStatus @default(OPEN)
  note                String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  items               SupplementRequestItem[]

  @@index([caseId, requestedAt])
}

model SupplementRequestItem {
  id                  String            @id @default(cuid())
  supplementRequestId String
  supplementRequest   SupplementRequest @relation(fields: [supplementRequestId], references: [id], onDelete: Cascade)
  caseDocumentItemId  String
  caseDocumentItem    CaseDocumentItem  @relation(fields: [caseDocumentItemId], references: [id])
  labelSnapshot       String
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())

  @@index([supplementRequestId, sortOrder])
}

model LegacyImportLog {
  id            String   @id @default(cuid())
  source        String
  version       String
  payloadJson   String?
  importedAt    DateTime @default(now())
  createdCount  Int      @default(0)
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         AdminRole
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
  auditLogs    AuditLog[]
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String?
  actorUser   User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actionType  AuditActionType
  entityType  AuditEntityType
  entityId    String
  summary     String
  metadataJson String?
  createdAt   DateTime        @default(now())
}

model ExternalIndicatorObservation {
  id              String   @id @default(cuid())
  observationDate DateTime
  indicatorKey    String
  category        String?
  numericValue    Float
  source          String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([observationDate, indicatorKey, category])
  @@index([indicatorKey, observationDate])
}

model ForecastEventFlag {
  id        String   @id @default(cuid())
  eventDate DateTime
  eventType String
  eventName String
  category  String?
  impactFlag Boolean @default(true)
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, eventDate])
}

model WeeklyForecastDataset {
  id                     String   @id @default(cuid())
  weekStartDate          DateTime
  category               String
  channel                String?
  inquiryCount           Int      @default(0)
  contractCount          Int      @default(0)
  avgProcessingDays      Float?
  revisionRequestCount   Int      @default(0)
  externalIndicatorsJson String   @default("{}")
  eventFlagsJson         String   @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([weekStartDate, category, channel])
  @@index([category, weekStartDate])
}

model DemandForecastRun {
  id                String             @id @default(cuid())
  targetMetric      ForecastMetric
  targetCategory    String
  targetChannel     String?
  horizonWeeks      Int
  modelName         String
  modelVersion      String?
  sourceWindowWeeks Int
  status            ForecastRunStatus  @default(PENDING)
  contextJson       String?
  note              String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?
  updatedAt         DateTime           @updatedAt
  points            DemandForecastPoint[]

  @@index([targetMetric, targetCategory, createdAt])
}

model DemandForecastPoint {
  id              String            @id @default(cuid())
  runId           String
  run             DemandForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetWeekStart DateTime
  predictedValue  Float
  lowerBound      Float?
  upperBound      Float?
  actualValue     Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([runId, targetWeekStart])
  @@index([targetWeekStart])
}
