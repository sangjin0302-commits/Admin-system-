generator client {
  provider = "prisma-client"
  output   = "../../admin-office-mvp-generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum InquiryType {
  FOREIGNER_VISA
  IMMIGRATION_STAY
  APOSTILLE_CONSULAR
  TRANSLATION_NOTARY
  GENERAL_ADMIN_CIVIL
  CORPORATE_REQUEST
  UNKNOWN
}

enum InquiryStatus {
  NEW
  PRE_DIAGNOSED
  CONSULTATION_REQUIRED
  QUOTE_DRAFTED
  QUOTE_PENDING
  ON_HOLD
  IN_REVIEW
  WAITING_CONSULTATION
  QUOTE_SENT
  WON
  CLOSED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LanguageCode {
  KO
  EN
  AR
}

enum PricingOptionType {
  FLAT
  PERCENT
}

enum PricingRuleType {
  URGENCY
  CONSULT
  PAYMENT
  POLICY
}

enum QuoteStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteLineKind {
  SERVICE
  URGENCY
  MANUAL
}

enum PaymentStageKind {
  RETAINER
  MIDTERM
  SUCCESS
}

enum ContractDraftStatus {
  DRAFT
  FINALIZED
  VOID
}

enum CaseStage {
  CONTRACT_PREPARATION
  ACTIVE
  ON_HOLD
  CLOSED
}

enum BridgeWorkflowStatus {
  NEW_INQUIRY
  TRIAGE_REVIEW
  AWAITING_MORE_FACTS
  PROFILED
  PROFILE_REVIEW_REQUIRED
  CASE_CARD_CREATED
  AWAITING_SOURCE_VERIFICATION
  DRAFT_CREATED
  MESSAGE_DRAFT_CREATED
  APPROVAL_PENDING
  APPROVED
  REVISION_REQUESTED
  BLOCKED
  CLOSED
}

enum WorkflowTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELED
}

enum WorkflowDraftStatus {
  DRAFT_CREATED
  APPROVAL_PENDING
  APPROVED
  REVISION_REQUESTED
  BLOCKED
  ARCHIVED
}

model Inquiry {
  id                       String        @id @default(cuid())
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  status                   InquiryStatus @default(NEW)
  inquiryType              InquiryType   @default(UNKNOWN)
  urgencyLevel             UrgencyLevel  @default(MEDIUM)
  classificationConfidence Float         @default(0)
  qualificationScore       Int           @default(0)
  preferredLanguage        LanguageCode  @default(KO)
  clientType               ClientType    @default(INDIVIDUAL)
  contactName              String
  organizationName         String?
  email                    String
  phone                    String?
  title                    String
  description              String
  nationality              String?
  currentStatus            String?
  requestedOutcome         String?
  requestedInquiryType     InquiryType?
  declaredUrgency          UrgencyLevel?
  documentCountry          String?
  targetAgency             String?
  hasPreparedDocuments     Boolean       @default(false)
  needsTranslation         Boolean       @default(false)
  isCorporateRequest       Boolean       @default(false)
  dueDate                  DateTime?
  assignee                 String?
  internalMemo             String?
  communicationLogs        String        @default("[]")
  latestContactAt          DateTime?
  latestContactChannel     String?
  latestContactSummary     String?
  nextContactAt            DateTime?
  responsePending          Boolean       @default(false)
  consultationRequired     Boolean       @default(false)
  riskComplexityHint       String?
  precheckRecommendedDocs  String        @default("[]")
  wantsCallback            Boolean       @default(false)
  consentToPrivacy         Boolean       @default(false)
  intakeSource             String        @default("website")
  generatedSummary         String
  generatedGuidance        String
  generatedReceiptMessage  String
  classificationReason     String
  recommendedNextStep      String
  serviceTags              String        @default("[]")
  lawbotLastAnalyzedAt     DateTime?
  lawbotSnapshotVersion    Int           @default(1)
  lawbotSnapshotStatus     String?
  lawbotSnapshotSummary    String?
  lawbotSnapshotPayload    String?
  bridgeWorkflowStatus     BridgeWorkflowStatus @default(NEW_INQUIRY)
  bridgeReviewRequired     Boolean       @default(false)
  bridgeMustVerify         String        @default("[]")
  bridgeMustVerifySources  String        @default("[]")
  bridgeRiskFlags          String        @default("[]")
  bridgePractitionerGuide  String?
  bridgeCaseOutlook        String?
  quotes                   Quote[]
  contractDrafts           ContractDraft[]
  cases                    CaseRecord[]
  caseTasks                CaseTask[]
  sourceVerificationTasks  SourceVerificationTask[]
  documentRequestTasks     DocumentRequestTask[]
  documentDrafts           DocumentDraft[]
  messageDrafts            MessageDraft[]
}

model ServiceType {
  id             String          @id @default(cuid())
  legacyId       String          @unique
  name           String
  category       String
  minPrice       Int
  maxPrice       Int
  isAppeal       Boolean         @default(false)
  isActive       Boolean         @default(true)
  source         String          @default("legacy-admin-suite")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quoteLineItems QuoteLineItem[]
}

model PricingOption {
  id               String            @id @default(cuid())
  legacyId         String            @unique
  name             String
  description      String
  optionType       PricingOptionType
  flatAmount       Int?
  percentRate      Int?
  unitLabel        String?
  isVat            Boolean           @default(false)
  isActive         Boolean           @default(true)
  source           String            @default("legacy-admin-suite")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quoteAdjustments QuoteAdjustment[]
}

model PricingRule {
  id           String          @id @default(cuid())
  code         String          @unique
  ruleType     PricingRuleType
  label        String
  description  String?
  numericValue Int?
  percentValue Int?
  jsonValue    String?
  isDefault    Boolean         @default(false)
  isActive     Boolean         @default(true)
  source       String          @default("legacy-admin-suite")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Quote {
  id                    String         @id @default(cuid())
  inquiryId             String
  inquiry               Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status                QuoteStatus    @default(DRAFT)
  selectedServiceLegacyIds String      @default("[]")
  selectedOptionLegacyIds String       @default("[]")
  urgencyRuleCode       String
  consultRuleCode       String
  paymentRuleCode       String         @default("PAYMENT_STANDARD")
  rangeMode             Boolean        @default(true)
  serviceBaseMin        Int            @default(0)
  serviceBaseMax        Int            @default(0)
  subtotalMin           Int            @default(0)
  subtotalMax           Int            @default(0)
  vatAmountMin          Int            @default(0)
  vatAmountMax          Int            @default(0)
  totalMin              Int            @default(0)
  totalMax              Int            @default(0)
  consultFee            Int            @default(0)
  successFeeRestricted  Boolean        @default(false)
  draftNotes            String?
  calculationSummary    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lineItems             QuoteLineItem[]
  adjustments           QuoteAdjustment[]
  paymentPlans          PaymentPlan[]
  contractDraft         ContractDraft?
  caseRecord            CaseRecord?
}

model QuoteLineItem {
  id            String         @id @default(cuid())
  quoteId       String
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceTypeId String?
  serviceType   ServiceType?   @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  kind          QuoteLineKind
  label         String
  description   String?
  amountMin     Int
  amountMax     Int
  sortOrder     Int            @default(0)
  isManual      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuoteAdjustment {
  id              String            @id @default(cuid())
  quoteId         String
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  pricingOptionId String?
  pricingOption   PricingOption?    @relation(fields: [pricingOptionId], references: [id], onDelete: SetNull)
  label           String
  description     String?
  optionType      PricingOptionType
  flatAmount      Int?
  percentRate     Int?
  computedMin     Int
  computedMax     Int
  isVat           Boolean           @default(false)
  sortOrder       Int               @default(0)
  isManual        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PaymentPlan {
  id         String           @id @default(cuid())
  quoteId    String
  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  stageKind  PaymentStageKind
  percentage Int
  dueText    String
  amountMin  Int
  amountMax  Int
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ContractDraft {
  id                   String              @id @default(cuid())
  inquiryId            String
  inquiry              Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quoteId              String              @unique
  quote                Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status               ContractDraftStatus @default(DRAFT)
  title                String
  bodyText             String
  scopeText            String?
  paymentSummary       String?
  successFeeRestricted Boolean             @default(false)
  specialTerms         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  caseRecord           CaseRecord?
}

model CaseRecord {
  id              String    @id @default(cuid())
  caseNumber      String    @unique
  inquiryId       String
  quoteId         String?   @unique
  contractDraftId String?   @unique
  currentStage    CaseStage @default(CONTRACT_PREPARATION)
  bridgeWorkflowStatus    BridgeWorkflowStatus @default(CASE_CARD_CREATED)
  bridgeReviewRequired    Boolean   @default(false)
  bridgeMustVerify        String    @default("[]")
  bridgeMustVerifySources String    @default("[]")
  bridgeRiskFlags         String    @default("[]")
  bridgePractitionerGuide String?
  bridgeCaseOutlook       String?
  dueDate         DateTime?
  internalMemo    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  inquiry         Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quote           Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contractDraft   ContractDraft? @relation(fields: [contractDraftId], references: [id], onDelete: SetNull)
  caseTasks               CaseTask[]
  sourceVerificationTasks SourceVerificationTask[]
  documentRequestTasks    DocumentRequestTask[]
  documentDrafts          DocumentDraft[]
  messageDrafts           MessageDraft[]
}

model CaseTask {
  id              String             @id @default(cuid())
  inquiryId       String
  caseId          String?
  title           String
  details         String?
  taskType        String             @default("GENERAL")
  status          WorkflowTaskStatus @default(OPEN)
  reviewRequired  Boolean            @default(false)
  mustVerify      String             @default("[]")
  riskFlags       String             @default("[]")
  source          String             @default("lawbot_bridge")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  completedAt     DateTime?
  inquiry         Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord      CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model SourceVerificationTask {
  id               String             @id @default(cuid())
  inquiryId        String
  caseId           String?
  documentDraftId  String?
  messageDraftId   String?
  title            String
  authorityBucket  String?
  sourceLabel      String
  sourceCitation   String?
  notes            String?
  status           WorkflowTaskStatus @default(OPEN)
  reviewRequired   Boolean            @default(true)
  mustVerify       String             @default("[]")
  riskFlags        String             @default("[]")
  source           String             @default("lawbot_bridge")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resolvedAt       DateTime?
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord       CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  documentDraft    DocumentDraft?     @relation(fields: [documentDraftId], references: [id], onDelete: SetNull)
  messageDraft     MessageDraft?      @relation(fields: [messageDraftId], references: [id], onDelete: SetNull)

  @@index([inquiryId, status])
  @@index([caseId, status])
  @@index([documentDraftId])
  @@index([messageDraftId])
}

model DocumentRequestTask {
  id               String             @id @default(cuid())
  inquiryId        String
  caseId           String?
  title            String
  documentLabel    String
  notes            String?
  status           WorkflowTaskStatus @default(OPEN)
  reviewRequired   Boolean            @default(false)
  mustVerify       String             @default("[]")
  riskFlags        String             @default("[]")
  source           String             @default("lawbot_bridge")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resolvedAt       DateTime?
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord       CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model DocumentDraft {
  id                      String             @id @default(cuid())
  inquiryId               String
  caseId                  String?
  draftType               String
  title                   String?
  bodyJson                String             @default("{}")
  status                  WorkflowDraftStatus @default(DRAFT_CREATED)
  reviewRequired          Boolean            @default(true)
  mustVerify              String             @default("[]")
  mustVerifySources       String             @default("[]")
  riskFlags               String             @default("[]")
  practitionerGuide       String?
  caseOutlook             String?
  source                  String             @default("lawbot_bridge")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  approvedAt              DateTime?
  inquiry                 Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord              CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  sourceVerificationTasks SourceVerificationTask[]

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model MessageDraft {
  id                      String             @id @default(cuid())
  inquiryId               String
  caseId                  String?
  messageKind             String
  subject                 String
  bodyText                String
  status                  WorkflowDraftStatus @default(DRAFT_CREATED)
  reviewRequired          Boolean            @default(true)
  mustVerify              String             @default("[]")
  mustVerifySources       String             @default("[]")
  riskFlags               String             @default("[]")
  practitionerGuide       String?
  caseOutlook             String?
  source                  String             @default("lawbot_bridge")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  approvedAt              DateTime?
  inquiry                 Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  caseRecord              CaseRecord?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  sourceVerificationTasks SourceVerificationTask[]

  @@index([inquiryId, status])
  @@index([caseId, status])
}

model LegacyImportLog {
  id            String   @id @default(cuid())
  source        String
  version       String
  payloadJson   String?
  importedAt    DateTime @default(now())
  createdCount  Int      @default(0)
}
