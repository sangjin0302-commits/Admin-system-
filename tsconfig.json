{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@generated/prisma-client/*": [
        "./generated/prisma-client-next/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@generated/*": [
        "./generated/*"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "generated/**/*.ts",
    "next-env.d.ts",
    "prisma/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-prod/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/generated/prisma",
    "src/generated/prisma-client"
  ]
}
