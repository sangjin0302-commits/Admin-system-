{
  "name": "admin-office-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:safe": "npm run preflight:spawn && npm run dev",
    "postinstall": "node scripts/prisma-generate-auto.mjs && node scripts/prepare-prisma-client.mjs",
    "build:prepare": "node scripts/prisma-generate-auto.mjs && node scripts/prepare-prisma-client.mjs",
    "build:prepare:strict": "node scripts/preflight/build-prepare-strict.mjs",
    "build": "next build && node scripts/ensure-prisma-engine-runtime.mjs",
    "build:safe": "npm run preflight:spawn && npm run build",
    "typecheck": "tsc --noEmit",
    "text:check": "node scripts/check-text-integrity-safe.mjs",
    "preflight:spawn": "node scripts/preflight/spawn-permission-check.mjs",
    "preflight:locks": "node scripts/preflight/lock-surface-check.mjs",
    "preflight": "npm run preflight:spawn && npm run preflight:locks",
    "debug:spawn": "node --require ./scripts/debug-spawn.cjs scripts/preflight/spawn-permission-check.mjs",
    "ops:env:check": "node scripts/check-production-env.mjs",
    "ops:smoke": "node scripts/smoke-admin-runtime.mjs",
    "ops:smoke:local": "node scripts/smoke-admin-runtime-local.mjs",
    "verify:ops": "npm run verify && npm run ops:env:check && npm run ops:smoke",
    "quickcheck": "npm run typecheck",
    "verify": "npm run build:prepare && npm run text:check && npm run typecheck && npm run build",
    "verify:safe": "npm run preflight:spawn && npm run preflight:locks && npm run text:check && npm run typecheck && npm run build:prepare",
    "verify:safe:strict": "npm run preflight:spawn && npm run preflight:locks && npm run text:check && npm run typecheck && npm run build:prepare:strict",
    "test:case-phase1": "tsx scripts/tests/case-matter-phase1-check.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "clean": "node scripts/clean-build.mjs",
    "rebuild": "npm run clean && npm run build",
    "start": "next start",
    "prisma:generate": "node scripts/prisma-generate-auto.mjs",
    "prisma:generate:sqlite": "node scripts/render-prisma-schema.mjs sqlite && prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:generate:postgres": "node scripts/render-prisma-schema.mjs postgresql && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:init": "node scripts/bootstrap-sqlite.mjs",
    "db:setup": "npm run db:init && npm run db:seed",
    "db:push": "prisma db push",
    "db:push:sqlite": "node scripts/render-prisma-schema.mjs sqlite && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push:postgres": "node scripts/render-prisma-schema.mjs postgresql && prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin-user.ts",
    "forecast:sync": "tsx scripts/sync-forecast-dataset.ts",
    "forecast:import": "tsx scripts/import-forecast-run.ts",
    "forecast:timesfm": "python scripts/timesfm_forecast.py",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@formkit/auto-animate": "^0.9.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^6.0.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tosspayments/tosspayments-sdk": "^2.7.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-medium-image-zoom": "^5.4.8",
    "recharts": "^3.8.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/experimental-nextjs-vite": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "webpack": "^5.108.3"
  }
}
