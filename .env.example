DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:C:/Users/your-user/AppData/Local/admin-office-mvp/dev-quotes.db"
ADMIN_SEED_EMAIL="admin@admin-office.local"
ADMIN_SEED_PASSWORD="Admin1234!"
STAFF_SEED_EMAIL="staff@admin-office.local"
STAFF_SEED_PASSWORD="Staff1234!"
OPENAI_API_KEY=""
OPENAI_CLASSIFIER_ENABLED="true"
OPENAI_CLASSIFIER_MODEL="gpt-4.1-mini"
OPENAI_CLASSIFIER_MIN_CONFIDENCE="0.72"
OPENAI_CLASSIFIER_TIMEOUT_MS="10000"
OPENAI_QUOTE_ASSISTANT_ENABLED="true"
OPENAI_QUOTE_ASSISTANT_MODEL="gpt-4.1-mini"
OPENAI_QUOTE_ASSISTANT_TIMEOUT_MS="12000"
OPENAI_CASE_ASSISTANT_ENABLED="true"
OPENAI_CASE_ASSISTANT_MODEL="gpt-4.1-mini"
OPENAI_CASE_ASSISTANT_TIMEOUT_MS="12000"
OPENAI_RELATIONSHIP_ASSISTANT_ENABLED="true"
OPENAI_RELATIONSHIP_ASSISTANT_MODEL="gpt-4.1-mini"
OPENAI_RELATIONSHIP_ASSISTANT_TIMEOUT_MS="12000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME="Admin Office"
INQUIRY_NOTIFICATION_TO=""
SEND_INQUIRY_CONFIRMATION="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SCHEDULE_BRIEFING_ENABLED="true"
ADMIN_APP_URL=""
CRON_SECRET=""

DOCUMENT_STORAGE_DRIVER="local"
LOCAL_DOCUMENT_UPLOAD_DIR="uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Local development example:
# DATABASE_PROVIDER="sqlite"
# DATABASE_URL="file:C:/Users/your-user/AppData/Local/admin-office-mvp/dev-quotes.db"
#
# Preview/production PostgreSQL example (Railway PostgreSQL):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway?sslmode=require"
# PGSSL_REJECT_UNAUTHORIZED="false"
# ADMIN_SEED_EMAIL="ops@your-domain.com"
# ADMIN_SEED_PASSWORD="<strong-random-password>"
# STAFF_SEED_EMAIL="staff@your-domain.com"
# STAFF_SEED_PASSWORD="<strong-random-password>"
# OPENAI_API_KEY="sk-..."
# OPENAI_CLASSIFIER_ENABLED="true"
# OPENAI_CLASSIFIER_MODEL="gpt-4.1-mini"
# OPENAI_CLASSIFIER_MIN_CONFIDENCE="0.72"
# OPENAI_CLASSIFIER_TIMEOUT_MS="10000"
# OPENAI_QUOTE_ASSISTANT_ENABLED="true"
# OPENAI_QUOTE_ASSISTANT_MODEL="gpt-4.1-mini"
# OPENAI_QUOTE_ASSISTANT_TIMEOUT_MS="12000"
# OPENAI_CASE_ASSISTANT_ENABLED="true"
# OPENAI_CASE_ASSISTANT_MODEL="gpt-4.1-mini"
# OPENAI_CASE_ASSISTANT_TIMEOUT_MS="12000"
# OPENAI_RELATIONSHIP_ASSISTANT_ENABLED="true"
# OPENAI_RELATIONSHIP_ASSISTANT_MODEL="gpt-4.1-mini"
# OPENAI_RELATIONSHIP_ASSISTANT_TIMEOUT_MS="12000"
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="noreply@your-domain.com"
# RESEND_FROM_NAME="Your Office"
# INQUIRY_NOTIFICATION_TO="owner@your-domain.com,staff@your-domain.com"
# SEND_INQUIRY_CONFIRMATION="true"
# TELEGRAM_BOT_TOKEN="123456789:AA..."
# TELEGRAM_CHAT_ID="123456789"
# TELEGRAM_SCHEDULE_BRIEFING_ENABLED="true"
# ADMIN_APP_URL="https://adminofficemvp2.vercel.app"
# CRON_SECRET="<strong-random-secret>"
#
# Important:
# - local SQLite uses `npx prisma generate --schema prisma/schema.prisma`
# - preview/production PostgreSQL uses `npm run prisma:generate:postgres`
#
# For external file storage, switch DOCUMENT_STORAGE_DRIVER to one of:
#    "s3", "r2", "vercel-blob"
#
# S3 example:
# DOCUMENT_STORAGE_DRIVER="s3"
# S3_BUCKET="admin-office-documents"
# S3_REGION="ap-northeast-2"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"
#
# R2 example (same S3-compatible adapter for Cloudflare R2 on Vercel):
# DOCUMENT_STORAGE_DRIVER="r2"
# S3_BUCKET="admin-office-documents"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"
