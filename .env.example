PRISMA_DB_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"
# Local dev quick start:
# 1) Copy this file to .env
# 2) Keep DATABASE_URL relative to this repository

ADMIN_BASIC_AUTH_USER=""
ADMIN_BASIC_AUTH_PASSWORD=""
ADMIN_ENFORCE_STRONG_CREDENTIALS="true"
ADMIN_MIN_PASSWORD_LENGTH="14"
ADMIN_AUTH_RATE_LIMIT_MAX_FAILURES="20"
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS="600000"
ADMIN_REQUIRE_SAME_ORIGIN="true"
ADMIN_ALLOW_MISSING_ORIGIN="false"
ADMIN_IP_ALLOWLIST=""
FORCE_HTTPS="true"

LAWBOT_ANALYZE_URL="http://127.0.0.1:8000/analyze/admin"
LAWBOT_ENABLE_AUTOMATIC_CALLS="false"
LAWBOT_ANALYZE_TIMEOUT_MS="8000"
LAWBOT_ANALYZE_TOKEN=""

NOTION_SYNC_ENABLED="false"
NOTION_TOKEN=""
NOTION_CASE_DATABASE_ID=""
NOTION_CONSULTATION_DATABASE_ID=""
NOTION_REFERENCE_ARCHIVE_DATABASE_ID=""
NOTION_REFERENCE_WEBSITE_DATABASE_ID=""

ADMIN_MARKETING_SYNC_TOKEN=""
ADMIN_MARKETING_SYNC_TOKEN_MIN_LENGTH="24"
ADMIN_MARKETING_RATE_LIMIT_WINDOW_MS="60000"
ADMIN_MARKETING_RATE_LIMIT_MAX_REQUESTS="30"
ADMIN_MARKETING_MAX_BODY_BYTES="524288"
AUTOPOST_MARKETING_PAYLOAD_PATH=""

PUBLIC_INTAKE_RATE_LIMIT_WINDOW_MS="300000"
PUBLIC_INTAKE_RATE_LIMIT_MAX_REQUESTS="25"
PUBLIC_INTAKE_MAX_BODY_BYTES="65536"
PUBLIC_INTAKE_DEDUP_WINDOW_MS="120000"
PUBLIC_INTAKE_MAINTENANCE_MODE="false"
PUBLIC_INTAKE_MAINTENANCE_RETRY_AFTER_SEC="300"
PUBLIC_INTAKE_MAINTENANCE_MESSAGE="현재 접수 서비스 점검 중입니다. 잠시 후 다시 시도해 주세요."
PUBLIC_INTAKE_ENABLE_HONEYPOT="true"
PUBLIC_INTAKE_REQUIRE_SAME_ORIGIN="true"
PUBLIC_INTAKE_ALLOW_MISSING_ORIGIN="false"
PUBLIC_INTAKE_ALLOWED_ORIGINS=""

# Public site
NEXT_PUBLIC_SITE_URL="https://ethos.kr"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_NAVER_ID=""

# Client notifications
NOTIFICATION_PROVIDER="none"      # resend | ses | aligo | none
RESEND_API_KEY=""
RESEND_FROM="noreply@ethos.kr"

# NextAuth (client portal)
AUTH_SECRET=""              # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3001"

# File uploads — local fallback (dev)
PORTAL_UPLOAD_DIR="./uploads"
PORTAL_UPLOAD_MAX_BYTES="10485760"   # 10MB

# File storage (운영). S3 / Cloudflare R2 / MinIO 등 S3 호환
# - AWS S3:  S3_REGION=ap-northeast-2, S3_ENDPOINT 비움
# - Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_DRIVER=""                    # s3|local (비우면 자동)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="portal-uploads"

# Vercel Cron — set a long random string, also configure on Vercel Project Settings
CRON_SECRET=""

# 법제처 (lawbot이 직접 호출 시)
MOLEG_API_OC=""

# PDF 한글 폰트
PDF_KOREAN_FONT_PATH="./fonts/NotoSansKR-Regular.ttf"

# ---------------------------------------------------------------------------
# Round V — 결제, 알림톡, 전자서명, 캘린더, 모니터링
# ---------------------------------------------------------------------------

# 토스페이먼츠 (https://developers.tosspayments.com)
TOSS_SECRET_KEY=""              # 시크릿 키 (test_sk_xxx / live_sk_xxx)
TOSS_WEBHOOK_SECRET=""          # 웹훅 서명 검증용 (Toss 대시보드에서 등록)
NEXT_PUBLIC_TOSS_CLIENT_KEY=""  # 클라이언트 키 (test_ck_xxx / live_ck_xxx) — 결제 위젯용

# Solapi 알림톡 (https://developers.solapi.com) — 카카오 비즈메시지
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""                  # 카카오 발신프로필 ID
SOLAPI_SENDER_PHONE=""          # SMS 폴백 발신번호 (선택)
SOLAPI_TEMPLATE_INQUIRY_RECEIVED=""
SOLAPI_TEMPLATE_CASE_STATUS=""
SOLAPI_TEMPLATE_DEADLINE=""
SOLAPI_TEMPLATE_PAYMENT=""

# 모두싸인 전자서명 (https://docs.modusign.co.kr)
MODUSIGN_API_KEY=""
MODUSIGN_USER_EMAIL=""
MODUSIGN_WEBHOOK_SECRET=""

# 공개 iCal 피드 (구글캘린더/아웃룩 구독)
CALENDAR_FEED_TOKEN=""          # 최소 24자 랜덤 문자열 (openssl rand -base64 24)
GOOGLE_CALENDAR_TOKEN=""        # 서버측 푸시용 OAuth access token (선택)

# Sentry 에러 모니터링 (https://sentry.io)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""               # 미설정 시 VERCEL_GIT_COMMIT_SHA 사용

# 멀티사무소 (확장용 — 단일 사무소면 비워둬도 됨)
TENANT_DEFAULT_NAME=""
TENANT_DEFAULT_SUBDOMAIN=""
TENANT_DEFAULT_OWNER=""
TENANT_DEFAULT_PLAN="enterprise"

# ---------------------------------------------------------------------------
# Round Y — Google Calendar OAuth + 전자세금계산서 (바로빌) + 서명완료 알림
# ---------------------------------------------------------------------------

# Google Calendar OAuth 2 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""          # 예: https://ethos.kr/api/auth/google/callback

# 바로빌 전자세금계산서 (https://www.baroservice.com)
BAROBILL_API_KEY=""
BAROBILL_CORP_NUM=""            # 발행자 사업자번호 10자리
BAROBILL_USER_ID=""
BAROBILL_BASE_URL=""            # 운영: https://ws.baroservice.com / 테스트: https://test-ws.baroservice.com

# 알림톡 추가 템플릿 (Round X에서 추가)
SOLAPI_TEMPLATE_ESIGN=""

# ---------------------------------------------------------------------------
# Round Z — Lawbot bridge + SEO + 사무소 연락처
# ---------------------------------------------------------------------------

# Lawbot bridge (사건 자동 분석 cron용)
LAWBOT_BRIDGE_BASE_URL=""
LAWBOT_SERVICE_KEY=""
LAWBOT_SERVICE_CALLER=""

# 공개 사이트 SEO (JSON-LD 연락처)
NEXT_PUBLIC_OFFICE_PHONE=""
NEXT_PUBLIC_OFFICE_EMAIL=""

# AdminUser 시드 (scripts/seed-admin-user.ts)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_NAME="ETHOS Admin"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_ROLE="SUPER"

# Inquiry 자동전환 (Round EE) — true 시 qualificationScore≥85 자동 사건 생성
AUTO_CONVERT_ENABLED="false"
# Solapi audit alert 템플릿 (Round EE — Audit 위험 액션 발생 시 SUPER에게 알림톡)
SOLAPI_TEMPLATE_AUDIT="admin_audit_alert"

# 텔레그램 봇 알림 — 신규 문의 접수 시 Jean에게 텔레그램 푸시
# 1) @BotFather → /newbot → BOT_TOKEN 발급
# 2) 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
